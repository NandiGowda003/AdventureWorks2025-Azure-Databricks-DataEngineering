{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-adventureworks2025"
		},
		"LS_ADLS_AdventureWorks_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_AdventureWorks'"
		},
		"LS_AzureSQL_Adventutrworks_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_AzureSQL_Adventutrworks'"
		},
		"LS_LocalSQL_AdventureWorks_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_LocalSQL_AdventureWorks'"
		},
		"LS_ADLS_AdventureWorks_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adventureworkstorageadls.dfs.core.windows.net/"
		},
		"LS_AzureSQL_Adventutrworks_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adventurework-sql-server.database.windows.net"
		},
		"LS_AzureSQL_Adventutrworks_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "free-sql-db-2598144"
		},
		"LS_AzureSQL_Adventutrworks_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "avinashcg"
		},
		"LS_LocalSQL_AdventureWorks_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "NANDIGOWDA\\SQLEXPRESS01"
		},
		"LS_LocalSQL_AdventureWorks_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "AdventureWorksDW2025"
		},
		"LS_LocalSQL_AdventureWorks_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "avinashcg"
		},
		"LS_REST_Frankfurter_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.frankfurter.app/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-adventureworks2025_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_AdventureWorks_accountKey": {
						"value": "[parameters('LS_ADLS_AdventureWorks_accountKey')]"
					},
					"LS_AzureSQL_Adventutrworks_password": {
						"value": "[parameters('LS_AzureSQL_Adventutrworks_password')]"
					},
					"LS_LocalSQL_AdventureWorks_password": {
						"value": "[parameters('LS_LocalSQL_AdventureWorks_password')]"
					},
					"LS_ADLS_AdventureWorks_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_AdventureWorks_properties_typeProperties_url')]"
					},
					"LS_AzureSQL_Adventutrworks_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQL_Adventutrworks_properties_typeProperties_server')]"
					},
					"LS_AzureSQL_Adventutrworks_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQL_Adventutrworks_properties_typeProperties_database')]"
					},
					"LS_AzureSQL_Adventutrworks_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQL_Adventutrworks_properties_typeProperties_userName')]"
					},
					"LS_REST_Frankfurter_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_Frankfurter_properties_typeProperties_url')]"
					},
					"LS_LocalSQL_AdventureWorks_properties_typeProperties_server": {
						"value": "[parameters('LS_LocalSQL_AdventureWorks_properties_typeProperties_server')]"
					},
					"LS_LocalSQL_AdventureWorks_properties_typeProperties_database": {
						"value": "[parameters('LS_LocalSQL_AdventureWorks_properties_typeProperties_database')]"
					},
					"LS_LocalSQL_AdventureWorks_properties_typeProperties_userName": {
						"value": "[parameters('LS_LocalSQL_AdventureWorks_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}